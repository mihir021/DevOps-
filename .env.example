# Root Environment Configuration for Docker Compose
# Comma-separated list of active Compose profiles (e.g. monitoring)
COMPOSE_PROFILES=

# Ports (defaults used if omitted)
MONGO_PORT=27017
SERVER_PORT=5000
CLIENT_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Local Docker Database URI
MONGODB_URI=mongodb://mongo:27017/mern_db
JWT_SECRET=devsecret1234567890abcdef
GRAFANA_ADMIN_PASSWORD=admin

