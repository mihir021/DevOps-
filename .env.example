# Root Environment Configuration for Docker Compose
# Comma-separated list of active Compose profiles (e.g. monitoring)
COMPOSE_PROFILES=

# Ports (defaults used if omitted)
SERVER_PORT=5000
CLIENT_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Production secrets (when running docker-compose.prod.yml)
MONGODB_URI=
JWT_SECRET=
GRAFANA_ADMIN_PASSWORD=admin
